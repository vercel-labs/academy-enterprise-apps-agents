AI_GATEWAY_API_KEY=
DATABASE_URL=

# Development-course adapter only. The UI displays a warning while enabled.
ALLOW_DEMO_IDENTITY=true
NEXT_PUBLIC_DEMO_IDENTITY=true

# For a real deployment, disable demo identity and configure the adapter with
# headers that a trusted identity proxy sets and strips from client requests.
VERIFIED_USER_EMAIL_HEADER=
VERIFIED_USER_SUBJECT_HEADER=
VERIFIED_USER_GROUPS_HEADER=
